# Template file for 'proxygen'
pkgname=proxygen
version=2025.10.13.00
revision=1
build_style=cmake
configure_args="-Wno-dev"
hostmakedepends="python gperf c-ares-devel perl snappy-devel"
makedepends="folly fizz-devel wangle mvfst"
short_desc="Collection of C++ HTTP libraries including an easy to use HTTP server"
maintainer="Daniel Martinez <danielmartinez@cock.li>"
license="BSD-3-Clause"
homepage="https://github.com/facebook/proxygen"
distfiles="https://github.com/facebook/proxygen/releases/download/v${version}/proxygen-v${version}.tar.gz"
checksum=ede59cf927febc9b457f57273fb05c39fa0fdfdb66fe586240b82aec9e2388c9

post_install() {
	vlicense LICENSE
}

proxygen-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} folly fizz-devel wangle mvfst"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.a"
		vmove usr/lib/cmake
	}
}
